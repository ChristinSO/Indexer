    "clsx": "^2.1.1", "tailwind-merge": "^3.0.0", "class-variance-authority": "^0.7.1"
  },
  "devDependencies": {
    "vite": "^7.0.0", "@vitejs/plugin-react": "^5.0.0", "typescript": "^5.9.0",
    "@types/react": "^19.0.0", "@types/react-dom": "^19.0.0", "@types/node": "^22.0.0",
    "tailwindcss": "^4.0.0", "@tailwindcss/vite": "^4.0.0", "playwright": "^1.64.0"
